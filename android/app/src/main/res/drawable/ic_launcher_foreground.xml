            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:color="#FF082F49" android:offset="0.0" />
                <item android:color="#FF0C4A6E" android:offset="0.5" />
                <item android:color="#FF0369A1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Squircle Border -->
    <path
        android:pathData="M18,10 L90,10 A8,8 0 0,1 98,18 L98,90 A8,8 0 0,1 90,98 L18,98 A8,8 0 0,1 10,90 L10,18 A8,8 0 0,1 18,10 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#FF22D3EE" />

    <!-- Inner Keypad Box -->
    <path
        android:pathData="M28,24 L80,24 A6,6 0 0,1 86,30 L86,78 A6,6 0 0,1 80,84 L28,84 A6,6 0 0,1 22,78 L22,30 A6,6 0 0,1 28,24 Z"
