    <path
        android:pathData="M43,24 L43,84 M65,24 L65,84 M22,44 L86,44 M22,64 L86,64"
        android:strokeWidth="1"
        android:strokeColor="#5538BDF8" />

    <!-- Glowing Center Quantum Core -->
    <path
        android:pathData="M54,54 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:gradientRadius="11"
                android:centerX="54"
                android:centerY="54"
                android:type="radial">
                <item android:color="#FF67E8F9" android:offset="0.0" />
                <item android:color="#FF06B6D4" android:offset="0.7" />
                <item android:color="#FF0891B2" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,54 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:strokeWidth="1.5"
        android:strokeColor="#FFE0F2FE" />
